# Copiar a .env.local y completar. NUNCA commitear .env.local con valores reales.

# URL base del backend Spring AI. En dev se usa el proxy de Vite (/api).
VITE_API_BASE_URL=/api

# Activar/desactivar la capa de datos mock (MSW).
# "true" = trabajar sin backend con datos falsos. "false" = pegarle al backend real.
VITE_ENABLE_MOCKS=true
