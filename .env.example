# Copiar a .env.local y completar. NUNCA commitear .env.local con valores reales.

# URL base UNICA para todo /api: dominio CRUD (querellas/quejas/fallos/
# actas/radicaciones, contra Postgres real) Y rutas de IA (/api/intake/chat,
# /api/legal/chat). Apunta DIRECTO a policia-legaltech-service -- el
# navegador NUNCA habla directo con orchestrator (decision confirmada con
# el usuario). policia-legaltech-service reenvia las rutas de IA
# server-to-server hacia orchestrator/legal.
# En produccion: la URL publica de policia-legaltech-service.
# En dev local: http://localhost:3101/api (puerto de
# policia-legaltech-service/.env, ver tambien local-dev/docker-compose.local.yml).
VITE_API_BASE_URL=http://localhost:3101/api

# Activar/desactivar la capa de datos mock (MSW).
# "true" = trabajar sin backend con datos falsos. "false" = pegarle al backend real.
VITE_ENABLE_MOCKS=true
