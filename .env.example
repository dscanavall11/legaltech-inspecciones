# Copiar a .env.local y completar. NUNCA commitear .env.local con valores reales.

# URL base UNICA para todo /api: dominio CRUD (querellas/quejas/fallos/
# actas/radicaciones, contra Postgres real), rutas de IA (/api/intake/chat,
# /api/legal/chat) y la resolucion de workspace-context al arrancar. Apunta
# DIRECTO a orchestrator -- el BFF unico de la plataforma, que reenvia hacia
# legalcase/legal/legalbases/authentication.
# En produccion: la URL publica de orchestrator.
# En dev local: http://localhost:8090/api (orchestrator expone 8090 en el
# host, ver local-dev/docker-compose.local.yml).
VITE_API_BASE_URL=http://localhost:8090/api

