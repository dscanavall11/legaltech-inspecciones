{
  "name": "legaltech-inspecciones",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plataforma de gestión de inspecciones de policía con IA — legaltech.com.co",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "type-check": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "deploy": "npm run build && aws s3 sync dist/ s3://legaltech-web-app --delete --cache-control \"max-age=31536000, public\" --exclude \"index.html\" --exclude \"mockServiceWorker.js\" && aws s3 cp dist/index.html s3://legaltech-web-app/index.html --cache-control \"no-cache, no-store, must-revalidate\" && aws cloudfront create-invalidation --distribution-id E2DDD5J2GYCJDS --paths \"/*\""
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.21.0",
    "dayjs": "^1.11.13",
    "gsap": "^3.15.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "pdfjs-dist": "^6.1.200",
    "pdfmake": "^0.3.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.59.0",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^4.1.9",
    "msw": "^2.4.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
